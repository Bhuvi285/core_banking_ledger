# Docker Compose settings: copy to .env and replace the password placeholder.
POSTGRES_DB=core_banking_ledger
POSTGRES_USER=ledger_app
POSTGRES_PASSWORD=replace-with-a-long-random-demo-password

# Local Maven execution only: set these process variables in PowerShell.
# Use the same username/password as above and this local URL:
# DB_URL=jdbc:postgresql://localhost:5433/core_banking_ledger
# DB_USERNAME=ledger_app
# DB_PASSWORD=replace-with-a-long-random-demo-password
